const char* sys_stateToStr(SystemState s) {
  switch (s) {
    case STATE_INIT:       return "INIT";
    case STATE_MONITORING: return "MONITORING";
    case STATE_IRRIGATING: return "IRRIGATING";
    case STATE_COOLDOWN:   return "COOLDOWN";
    case STATE_FAULT:      return "FAULT";
    case STATE_EMERGENCY:  return "EMERGENCY";
    default:               return "UNKNOWN";
  }
}

const char* sys_sensorStatusToStr(SensorStatus s) {
  switch (s) {
    case SENSOR_OK:           return "OK";
    case SENSOR_FAULT:        return "FAULT";
    case SENSOR_FROZEN:       return "FROZEN";
    case SENSOR_DISCONNECTED: return "DISCONNECTED";
    case SENSOR_UNSTABLE:     return "UNSTABLE";
    default:                  return "UNKNOWN";
  }
}
